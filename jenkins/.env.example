# Copiar a jenkins/.env (ignorado por Git) y completar.

# Puerto local de la UI (cambiar si 8080 ya está ocupado).
JENKINS_PORT=8080

# Usuario administrador de Jenkins (solo local).
JENKINS_ADMIN_ID=admin
JENKINS_ADMIN_PASSWORD=cambia-esta-clave

# Notificación por correo (Gmail SMTP con contraseña de aplicación:
# https://myaccount.google.com/apppasswords). Dejar vacío para omitir el correo.
SMTP_USER=tu_correo@gmail.com
SMTP_APP_PASSWORD=
NOTIFY_EMAIL=tu_correo@gmail.com

# Repositorio y ramas vigiladas por Poll SCM (separadas por coma).
CDPROD_REPO_URL=https://github.com/Mariog89/CDProd.git
CDPROD_BRANCHES=*/main,*/develop

# Ruta absoluta del archivo ADC de gcloud en el host
# (se genera con: gcloud auth application-default login).
GCLOUD_ADC_FILE=C:/Users/<usuario>/AppData/Roaming/gcloud/application_default_credentials.json
